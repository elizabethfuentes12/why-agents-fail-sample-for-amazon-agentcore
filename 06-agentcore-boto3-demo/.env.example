#
# Environment template for deploying the Hotel Booking Agent (boto3 plan B).
# Copy this file to .env and fill in your real values:
#     cp .env.example .env
# .env is git-ignored; .env.example is committed as the reference.

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Neo4j — choose ONE of the two setups below
# ---------------------------------------------------------------------------

# === Option A: Neo4j AuraDB (managed, public TLS endpoint) — RECOMMENDED ===
# Full connection URI from the Aura console. Note the neo4j+s:// scheme (routing + TLS).
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# Host only (the deploy notebook can derive this from NEO4J_URI; set it if you prefer).
NEO4J_HOST=xxxxxxxx.databases.neo4j.io
# Neo4j password. Used to (a) load the graph with build_graph.py and
# (b) create the Secrets Manager secret the query Lambda reads.
NEO4J_PASSWORD=your-aura-password
# Secrets Manager ARN holding the Neo4j password (JSON {"password": "..."} or plain text).
# Create it first, e.g.:
#   aws secretsmanager create-secret --name workshop-neo4j-aura \
#     --secret-string '{"password":"your-aura-password"}' --region us-east-1
NEO4J_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:workshop-neo4j-aura-XXXXXX

# With AuraDB leave SECURITY_GROUP_ID and SUBNET_IDS EMPTY: Aura is a public
# TLS endpoint, so the query Lambda must NOT run inside a VPC.
SECURITY_GROUP_ID=
SUBNET_IDS=

# === Option B: Self-hosted Neo4j on EC2 inside a VPC (workshop default) ===
# Use these INSTEAD of the Aura values above when Neo4j runs on a private IP.
#   NEO4J_HOST=10.0.1.23                 # private IP of the EC2 running Neo4j
#   NEO4J_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:...
#   SECURITY_GROUP_ID=sg-0123456789abcdef0
#   SUBNET_IDS=subnet-aaa,subnet-bbb     # comma-separated, same VPC as Neo4j
