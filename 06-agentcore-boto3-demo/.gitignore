# Regenerable deployment artifacts (rebuild with: pip install -t deployment_package -r agent_requirements.txt)
# Platform-specific (Linux aarch64) — do not commit.
deployment_package/
__pycache__/
*.pyc

# Local secrets / environment — never commit (.env.example IS committed as the template)
.env
!.env.example

# AgentCore deployment state — generated by `Runtime.configure()` on deploy.
# Contains the AWS account ID, IAM role ARNs, ECR repository, runtime ARN and
# local absolute paths, so it is per-user infrastructure state, not source.
.bedrock_agentcore.yaml
.bedrock_agentcore.yaml.*
*.bak

# Executed notebooks and run logs capture ARNs/account IDs in their outputs
*_executed.ipynb
*.log
