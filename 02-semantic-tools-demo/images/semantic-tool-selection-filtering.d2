direction: right
classes: {
  bad:      { style: { fill: "#fef2f2"; stroke: "#dc2626"; stroke-width: 2; font-color: "#7f1d1d"; border-radius: 12 } }
  good:     { style: { fill: "#f0fdf4"; stroke: "#16a34a"; stroke-width: 2; font-color: "#14532d"; border-radius: 12 } }
  hdr-bad:  { style: { fill: "#dc2626"; stroke: "#dc2626"; font-color: "#ffffff"; bold: true; border-radius: 8 } }
  hdr-good: { style: { fill: "#16a34a"; stroke: "#16a34a"; font-color: "#ffffff"; bold: true; border-radius: 8 } }
}

trad: "" {
  class: bad
  h: Traditional Tool Discovery { class: hdr-bad }
  body: |md
    All 29 tool descriptions sent every call

    **✗ Wrong tool selected — error rate 25%**

    **~4,500 tokens / call**

    Slower, costlier responses
  | { width: 380; style.font-color: "#7f1d1d" }
  h -> body: { style.stroke: "#dc2626" }
}

sem: "" {
  class: good
  h: Semantic Tool Discovery { class: hdr-good }
  body: |md
    FAISS filters to the top 3 relevant tools

    **✓ Correct tool — error rate 0%**

    **~500 tokens / call**

    Faster, cheaper responses
  | { width: 380; style.font-color: "#14532d" }
  h -> body: { style.stroke: "#16a34a" }
}
