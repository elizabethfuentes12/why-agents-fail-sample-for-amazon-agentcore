direction: right

classes: {
  endpoint: { style: { fill: "#f1f5f9"; stroke: "#64748b"; stroke-width: 2; font-color: "#334155"; border-radius: 12 } }
  step:     { style: { fill: "#eef2ff"; stroke: "#4f46e5"; stroke-width: 2; font-color: "#312e81"; border-radius: 12; bold: true } }
  win:      { style: { fill: "#f0fdf4"; stroke: "#16a34a"; stroke-width: 2; font-color: "#14532d"; border-radius: 12; bold: true } }
}

q: User Query { class: endpoint }
search: Vector Similarity\nSearch (FAISS) { class: step }
top3: Top 3 Tools\n(from 29) { class: step }
agent: Agent { class: step }
result: Correct Selection\n0% error · ~500 tokens { class: win }

q -> search: { style.stroke: "#4f46e5" }
search -> top3: { style.stroke: "#4f46e5" }
top3 -> agent: { style.stroke: "#4f46e5" }
agent -> result: { style.stroke: "#16a34a" }
