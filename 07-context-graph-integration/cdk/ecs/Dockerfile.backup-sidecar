# Neo4j Backup Sidecar
# Contains Neo4j tools (cypher-shell, neo4j-admin) and AWS CLI for S3 uploads

FROM neo4j:2026.01-enterprise-trixie

USER root

# Install AWS CLI v2 and dependencies
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    procps \
    && curl "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o "awscliv2.zip" \
    && unzip awscliv2.zip \
    && ./aws/install \
    && rm -rf awscliv2.zip aws \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy backup script
COPY backup-sidecar.sh /usr/local/bin/backup-sidecar.sh
RUN chmod +x /usr/local/bin/backup-sidecar.sh

# Switch back to neo4j user for running the script
USER neo4j

# Default environment variables
ENV BACKUP_INTERVAL_SECONDS=300
ENV NEO4J_HOST=localhost
ENV NEO4J_USER=neo4j

ENTRYPOINT ["/usr/local/bin/backup-sidecar.sh"]
