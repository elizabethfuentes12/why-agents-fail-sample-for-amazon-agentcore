direction: right

classes: {
  bad: {
    style: { fill: "#fef2f2"; stroke: "#dc2626"; stroke-width: 2; font-color: "#7f1d1d"; border-radius: 12 }
  }
  good: {
    style: { fill: "#f0fdf4"; stroke: "#16a34a"; stroke-width: 2; font-color: "#14532d"; border-radius: 12 }
  }
  hdr-bad: {
    style: { fill: "#dc2626"; stroke: "#dc2626"; font-color: "#ffffff"; bold: true; border-radius: 8 }
  }
  hdr-good: {
    style: { fill: "#16a34a"; stroke: "#16a34a"; font-color: "#ffffff"; bold: true; border-radius: 8 }
  }
}

prompt: "" {
  class: bad
  h: Prompt Engineering { class: hdr-bad }
  code: |python
    system_prompt = """
    IMPORTANT: Never confirm
    without payment.
    CRITICAL: Max 10 guests.
    """
  |
  traits: |md
    ✓ Natural language

    ✓ Flexible, conversational

    **✗ LLM can silently ignore**

    **✗ Not enforced**
  | { width: 280; style.font-color: "#7f1d1d" }
  h -> code -> traits: { style.stroke: "#dc2626" }
}

rules: "" {
  class: good
  h: Symbolic Rules { class: hdr-good }
  code: |python
    if not payment_verified:
        return "BLOCKED"
    if guests > 10:
        return "BLOCKED"
  |
  traits: |md
    ✓ Deterministic business logic

    ✓ Verifiable

    **✓ Enforced at execution**

    **✓ Cannot be bypassed**
  | { width: 280; style.font-color: "#14532d" }
  h -> code -> traits: { style.stroke: "#16a34a" }
}
