direction: right

classes: {
  endpoint: { style: { fill: "#f1f5f9"; stroke: "#64748b"; stroke-width: 2; font-color: "#334155"; border-radius: 12 } }
  step:     { style: { fill: "#eef2ff"; stroke: "#4f46e5"; stroke-width: 2; font-color: "#312e81"; border-radius: 12; bold: true } }
  ctrl:     { style: { fill: "#fff7ed"; stroke: "#ea580c"; stroke-width: 2; font-color: "#7c2d12"; border-radius: 12; bold: true } }
  win:      { style: { fill: "#f0fdf4"; stroke: "#16a34a"; stroke-width: 2; font-color: "#14532d"; border-radius: 12; bold: true } }
}

req: User Request { class: endpoint }
llm: LLM\nunderstands intent { class: step }
control: Agent Control server\nevaluates tool call { class: ctrl }
correct: Self-Correct\nsteer, not block { class: ctrl }
resp: Final Response { class: win }

req -> llm: { style.stroke: "#4f46e5" }
llm -> control: tool call { style.stroke: "#4f46e5" }
control -> correct: STEER { style.stroke: "#ea580c" }
correct -> llm: retry with fix { style: { stroke: "#ea580c"; stroke-dash: 4 } }
correct -> resp: { style.stroke: "#16a34a" }
